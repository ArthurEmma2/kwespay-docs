---
import { href as to } from '../lib/site';
import { askClaudeAboutDocs } from '../lib/llms';
import ClaudeMark from './ClaudeMark.astro';

const startHere = [
	{ n: '01', title: 'Make a testnet payment', href: '/getting-started/quickstart/', note: 'Quote, pay and confirm with the SDK' },
	{ n: '02', title: 'Verify it on your server', href: '/guides/payment-confirmation/', note: 'Trust the backend status, not the browser' },
	{ n: '03', title: 'Go live', href: '/getting-started/production-checklist/', note: 'Switch endpoints, keys and networks' },
];

const index = [
	{
		label: 'Start integrating',
		href: '/overview/how-it-works/',
		summary: 'How a quote becomes a signed, on-chain payment, and who is responsible for each step.',
		links: [
			{ title: 'Core concepts', href: '/overview/core-concepts/' },
			{ title: 'Environment setup', href: '/getting-started/environment-setup/' },
		],
	},
	{
		label: 'Add checkout',
		href: '/guides/checkout-widget/',
		summary: 'Drop the hosted payment modal into any page. It handles wallets, networks and tokens.',
		links: [
			{ title: 'Choosing an integration', href: '/guides/' },
			{ title: 'Widget events', href: '/guides/checkout-widget/#browser-events' },
		],
	},
	{
		label: 'Use the JavaScript SDK',
		href: '/guides/javascript-sdk/',
		summary: 'Build your own checkout with @kwespay/client and a wallet on EVM, Sui or Stellar.',
		links: [
			{ title: 'KwesPayClient methods', href: '/sdk/methods/' },
			{ title: 'Types', href: '/sdk/types/' },
		],
	},
	{
		label: 'Verify a payment',
		href: '/guides/payment-confirmation/',
		summary: 'Read the authoritative status for a transaction reference and fulfil the order once.',
		links: [
			{ title: 'Payment statuses', href: '/merchants/payment-statuses/' },
			{ title: 'Error handling', href: '/guides/error-handling/' },
		],
	},
	{
		label: 'Explore the API',
		href: '/api/',
		summary: 'The public GraphQL operations behind every integration, with request and response shapes.',
		links: [
			{ title: 'createQuote', href: '/api/operations/create-quote/' },
			{ title: 'getTransactionStatus', href: '/api/operations/get-transaction-status/' },
		],
	},
	{
		label: 'Networks and contracts',
		href: '/overview/networks/',
		summary: 'Supported chains and assets, contract addresses, fees and the on-chain checks.',
		links: [
			{ title: 'Contract architecture', href: '/contracts/' },
			{ title: 'Fee model', href: '/contracts/fee-model/' },
		],
	},
];

const flow = [
	{ step: 'Quote', who: 'Your app → KwesPay API', text: 'A fiat amount is priced in a token on one network and locked for 10 minutes.' },
	{ step: 'Sign', who: 'KwesPay API', text: 'The backend fixes amount, merchant, token, fee and deadline, then signs them.' },
	{ step: 'Pay', who: 'Customer wallet → contract', text: 'The wallet submits the transaction. The contract checks the signature and pays the merchant directly.' },
	{ step: 'Confirm', who: 'KwesPay listeners', text: 'The backend matches the on-chain event to the transaction and records the final status.' },
];

const environments = [
	{ name: 'Mainnet API', value: 'https://api.kwespay.xyz/graphql' },
	{ name: 'Testnet API', value: 'https://api.testnet.kwespay.xyz/graphql' },
	{ name: 'Dashboard', value: 'https://app.kwespay.xyz', link: true },
	{ name: 'Testnet dashboard', value: 'https://app.testnet.kwespay.xyz', link: true },
	{ name: 'Testnet console', value: 'https://console.kwespay.xyz', link: true },
];
---

<div class="kp-home not-content">
	<section class="kp-intro" aria-labelledby="_top">
		<div class="kp-intro-main">
			<p class="kp-eyebrow">KwesPay developer documentation</p>
			<h1 id="_top">Accept crypto.<br />Price in fiat.</h1>
			<p class="kp-lede">
				KwesPay prices an order in fiat, signs the payment terms, and lets your customer pay the merchant
				directly through a contract on EVM networks, Sui or Stellar. KwesPay never holds the funds. These
				docs cover the checkout widget, the JavaScript SDK, the GraphQL API and the contracts.
			</p>
			<button type="button" class="kp-search" data-kp-search>
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
				<span>Search the documentation</span>
				<kbd data-kp-shortcut>Ctrl K</kbd>
			</button>
			<a class="kp-primary" href={to('/getting-started/quickstart/')}>
				<span class="kp-primary-label">Quickstart</span>
				<span>Make your first testnet payment with the SDK</span>
				<span aria-hidden="true">→</span>
			</a>
			<a class="kp-primary kp-ask" href={askClaudeAboutDocs()} target="_blank" rel="noopener noreferrer">
				<span class="kp-primary-label"><ClaudeMark size={13} /> Ask Claude</span>
				<span>Ask questions about these docs in Claude</span>
				<span aria-hidden="true">↗</span>
				<span class="sr-only">(opens claude.ai in a new tab)</span>
			</a>
		</div>
		<nav class="kp-start" aria-label="Start here">
			<p class="kp-section-label">Start here</p>
			<ol>
				{
					startHere.map((item) => (
						<li>
							<a href={to(item.href)}>
								<span class="kp-n">{item.n}</span>
								<span class="kp-start-text">
									<span class="kp-start-title">{item.title}</span>
									<span class="kp-start-note">{item.note}</span>
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	</section>

	<section class="kp-index" aria-labelledby="kp-index-heading">
		<header class="kp-section-head">
			<h2 id="kp-index-heading">Guide index</h2>
			<p>Organised by the job in front of you.</p>
		</header>
		<div class="kp-grid">
			{
				index.map((item, i) => (
					<article class="kp-entry">
						<p class="kp-n">{String(i + 1).padStart(2, '0')}</p>
						<h3>
							<a href={to(item.href)}>{item.label}</a>
						</h3>
						<p class="kp-entry-summary">{item.summary}</p>
						<ul>
							{item.links.map((l) => (
								<li>
									<a href={to(l.href)}>{l.title}</a>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section class="kp-flow" aria-labelledby="kp-flow-heading">
		<header class="kp-section-head">
			<h2 id="kp-flow-heading">How a payment moves</h2>
			<p>
				The same four steps on every chain. <a href={to('/overview/how-it-works/')}>Read the full flow</a>
			</p>
		</header>
		<ol class="kp-flow-list">
			{
				flow.map((f, i) => (
					<li>
						<p class="kp-n">{String(i + 1).padStart(2, '0')}</p>
						<p class="kp-flow-step">{f.step}</p>
						<p class="kp-flow-who">{f.who}</p>
						<p class="kp-flow-text">{f.text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="kp-env" aria-labelledby="kp-env-heading">
		<header class="kp-section-head">
			<h2 id="kp-env-heading">Environments</h2>
			<p>
				Testnet and mainnet are separate systems with separate accounts and keys. <a href={to('/getting-started/testnet-vs-mainnet/')}>Compare them</a>
			</p>
		</header>
		<dl>
			{
				environments.map((e) => (
					<div>
						<dt>{e.name}</dt>
						<dd>{e.link ? <a href={e.value}>{e.value.replace('https://', '')}</a> : <code>{e.value}</code>}</dd>
					</div>
				))
			}
		</dl>
	</section>
</div>

<script>
	const trigger = document.querySelector<HTMLButtonElement>('[data-kp-search]');
	const shortcut = document.querySelector<HTMLElement>('[data-kp-shortcut]');
	if (shortcut && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) shortcut.textContent = '⌘ K';
	trigger?.addEventListener('click', (event) => {
		event.stopPropagation();
		document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
	});
</script>

<style>
	.kp-home {
		--kp-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
		max-width: 72rem;
		margin-inline: auto;
		padding-block: clamp(1.5rem, 1rem + 3vw, 4rem) 2rem;
		color: var(--kp-ink-2);
	}

	.kp-home a {
		color: inherit;
		text-decoration: none;
	}

	.kp-intro {
		display: grid;
		gap: var(--kp-gap);
		grid-template-columns: minmax(0, 1fr);
		padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
	}

	@media (min-width: 60rem) {
		.kp-intro {
			grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
			align-items: end;
		}
	}

	.kp-eyebrow,
	.kp-section-label,
	.kp-n,
	.kp-primary-label,
	.kp-flow-who,
	.kp-env dt {
		font-family: var(--kp-font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--kp-muted);
		margin: 0;
	}

	.kp-intro h1 {
		margin: 1.25rem 0 0;
		font-size: clamp(2.5rem, 1.6rem + 4.2vw, 4.75rem);
		line-height: 0.98;
		font-weight: 700;
		letter-spacing: -0.045em;
		color: var(--kp-ink);
	}

	.kp-lede {
		margin: 1.5rem 0 0;
		max-width: 38rem;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
		line-height: 1.6;
		color: var(--kp-muted);
		text-wrap: pretty;
	}

	.kp-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		max-width: 34rem;
		margin-top: 2rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--kp-rule-strong);
		border-radius: 2px;
		background: var(--kp-raised);
		color: var(--kp-muted);
		font: inherit;
		font-size: 1rem;
		text-align: start;
		cursor: text;
	}

	.kp-search:hover {
		border-color: var(--kp-faint);
		color: var(--kp-ink);
	}

	.kp-search span {
		flex: 1;
	}

	.kp-search kbd {
		font-family: var(--kp-font-mono);
		font-size: 0.75rem;
		color: var(--kp-faint);
		background: transparent;
		border: none;
	}

	.kp-primary {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.875rem;
		max-width: 34rem;
		margin-top: 1rem;
		padding-block: 0.25rem;
		font-size: 0.9375rem;
		font-weight: 550;
		color: var(--kp-ink) !important;
	}

	.kp-primary .kp-primary-label {
		color: var(--kp-accent-ink);
	}

	.kp-primary.kp-ask {
		margin-top: 0.25rem;
	}

	.kp-primary:hover span:nth-child(2) {
		text-decoration: underline;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.kp-start ol {
		list-style: none;
		margin: 0.875rem 0 0;
		padding: 0;
		border-top: 1px solid var(--kp-ink);
	}

	.kp-start li {
		border-bottom: 1px solid var(--kp-rule);
	}

	.kp-start a {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: 0.25rem;
		padding: 1rem 0;
	}

	.kp-start .kp-n {
		color: var(--kp-accent-ink);
		line-height: 1.6rem;
	}

	.kp-start-title {
		display: block;
		font-weight: 600;
		color: var(--kp-ink);
	}

	.kp-start-note {
		display: block;
		font-size: 0.875rem;
		color: var(--kp-muted);
	}

	.kp-start a:hover .kp-start-title {
		color: var(--kp-accent-ink);
	}

	.kp-section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--kp-ink);
	}

	.kp-section-head h2 {
		margin: 0;
		font-size: 1.375rem;
		font-weight: 680;
		letter-spacing: -0.02em;
		color: var(--kp-ink);
	}

	.kp-section-head p {
		margin: 0;
		font-size: 0.9375rem;
		color: var(--kp-muted);
	}

	.kp-section-head p a {
		color: var(--kp-accent-ink);
		text-decoration: underline;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		text-decoration-color: color-mix(in srgb, var(--kp-accent-ink) 35%, transparent);
	}

	.kp-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		column-gap: var(--kp-gap);
		margin-top: 1.5rem;
	}

	@media (min-width: 40rem) {
		.kp-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.kp-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.kp-entry {
		padding: 1.25rem 0 2rem;
		border-top: 1px solid var(--kp-rule);
	}

	.kp-entry h3 {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--kp-ink);
	}

	.kp-entry h3 a:hover {
		color: var(--kp-accent-ink);
	}

	.kp-entry-summary {
		margin: 0.5rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--kp-muted);
	}

	.kp-entry ul {
		list-style: none;
		margin: 0.875rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.875rem;
	}

	.kp-entry li a {
		color: var(--kp-ink-2);
		text-decoration: underline;
		text-decoration-color: var(--kp-rule-strong);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.kp-entry li a:hover {
		color: var(--kp-ink);
		text-decoration-color: currentColor;
	}

	.kp-flow,
	.kp-env {
		margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
	}

	.kp-flow-list {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		column-gap: var(--kp-gap);
	}

	@media (min-width: 40rem) {
		.kp-flow-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.kp-flow-list {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.kp-flow-list li {
		padding: 1.25rem 0 1.5rem;
		border-top: 1px solid var(--kp-rule);
	}

	.kp-flow-list .kp-n {
		color: var(--kp-accent-ink);
	}

	.kp-flow-step {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
		font-weight: 650;
		color: var(--kp-ink);
	}

	.kp-flow-who {
		margin-top: 0.25rem;
		text-transform: none;
		letter-spacing: 0;
		font-weight: 500;
	}

	.kp-flow-text {
		margin: 0.625rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--kp-muted);
	}

	.kp-env dl {
		margin: 1.25rem 0 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	.kp-env dl > div {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.125rem 1.5rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--kp-rule);
	}

	@media (min-width: 40rem) {
		.kp-env dl > div {
			grid-template-columns: 12rem minmax(0, 1fr);
			align-items: baseline;
		}
	}

	.kp-env dd {
		margin: 0;
		font-family: var(--kp-font-mono);
		font-size: 0.8125rem;
		color: var(--kp-ink);
		overflow-wrap: anywhere;
	}

	.kp-env dd code {
		font: inherit;
		background: none;
		border: none;
		padding: 0;
	}

	.kp-env dd a {
		text-decoration: underline;
		text-decoration-color: var(--kp-rule-strong);
		text-underline-offset: 0.22em;
	}

	.kp-env dd a:hover {
		text-decoration-color: currentColor;
	}
</style>
