---
import { breadcrumbs } from '../lib/breadcrumbs';
import { href } from '../lib/site';
import { askClaudeAboutPage } from '../lib/llms';
import ClaudeMark from './ClaudeMark.astro';

const route = Astro.locals.starlightRoute;
const { title, description, template } = route.entry.data;
const isHome = route.id === '' || route.id === 'index';
const isSplash = template === 'splash' || route.id === '404';
const crumbs = breadcrumbs(route.sidebar) ?? [];
const askClaude = askClaudeAboutPage(title, route.id);
---

{
	!isHome && (
		<div class="kp-title">
			<div class="kp-title-bar" hidden={isSplash}>
				<nav class="kp-crumbs" aria-label="Breadcrumb">
					<ol>
						<li>
							<a href={href('/')}>Docs</a>
						</li>
						{crumbs.map((c) => (
							<li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
						))}
					</ol>
				</nav>
				<div class="kp-actions">
					<a
						class="kp-copy kp-ask"
						href={askClaude}
						target="_blank"
						rel="noopener noreferrer"
						title="Open Claude with this page loaded so you can ask questions about it"
					>
						<ClaudeMark size={12} />
						Ask Claude<span aria-hidden="true"> ↗</span>
						<span class="sr-only"> (opens claude.ai in a new tab)</span>
					</a>
					<button type="button" class="kp-copy" data-kp-copy-page>
						Copy link
					</button>
				</div>
			</div>
			<h1 id="_top">{title}</h1>
			{description && <p class="kp-lede">{description}</p>}
		</div>
	)
}
<p class="kp-copy-status" role="status" aria-live="polite" data-kp-copy-status></p>

<script>
	const status = document.querySelector<HTMLElement>('[data-kp-copy-status]');
	let timer: number | undefined;

	function canonicalUrl(hash = '') {
		const link = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
		const url = new URL(link?.href ?? location.href);
		url.search = '';
		url.hash = hash;
		return url.href;
	}

	function announce(text: string) {
		if (!status) return;
		status.textContent = text;
		status.dataset.visible = 'true';
		window.clearTimeout(timer);
		timer = window.setTimeout(() => {
			status.dataset.visible = 'false';
			status.textContent = '';
		}, 1800);
	}

	async function copy(text: string, label: string) {
		try {
			await navigator.clipboard.writeText(text);
			announce(label);
		} catch {
			announce('Copy failed. Use the address bar instead.');
		}
	}

	document.querySelector('[data-kp-copy-page]')?.addEventListener('click', () => {
		copy(canonicalUrl(), 'Page link copied');
	});

	document.querySelectorAll<HTMLAnchorElement>('.sl-markdown-content a.sl-anchor-link').forEach((anchor) => {
		anchor.addEventListener('click', () => {
			const hash = decodeURIComponent(new URL(anchor.href).hash);
			copy(canonicalUrl(hash), 'Section link copied');
		});
	});
</script>

<style>
	.kp-title {
		margin-top: 1.5rem;
		padding-bottom: 0.25rem;
	}

	.kp-title-bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.kp-crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.kp-crumbs,
	.kp-copy {
		font-family: var(--kp-font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--kp-muted);
	}

	.kp-crumbs li + li::before {
		content: '/';
		margin-inline-end: 0.5rem;
		color: var(--kp-faint);
	}

	.kp-crumbs a {
		color: var(--kp-muted);
		text-decoration: none;
	}

	.kp-crumbs a:hover {
		color: var(--kp-ink);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.kp-actions {
		display: flex;
		flex-shrink: 0;
		align-items: baseline;
		gap: 1.25rem;
	}

	.kp-copy {
		flex-shrink: 0;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.kp-copy:hover {
		color: var(--kp-ink);
	}

	.kp-ask {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--kp-accent-ink);
		text-decoration: none;
	}

	.kp-ask:hover {
		color: var(--kp-accent-ink);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	@media (max-width: 30rem) {
		.kp-title-bar {
			flex-wrap: wrap;
		}
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.6rem + 1.6vw, var(--sl-text-h1));
		line-height: 1.1;
		font-weight: 680;
		letter-spacing: -0.03em;
		color: var(--kp-ink);
		text-wrap: balance;
	}

	.kp-lede {
		margin: 1rem 0 0;
		max-width: 40rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--kp-muted);
		text-wrap: pretty;
	}

	.kp-copy-status {
		position: fixed;
		inset-inline-start: 50%;
		bottom: 1.5rem;
		z-index: 30;
		margin: 0;
		transform: translateX(-50%);
		padding: 0.5rem 0.875rem;
		background: var(--kp-ink);
		color: var(--kp-paper);
		font-family: var(--kp-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		border-radius: 2px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	.kp-copy-status[data-visible='true'] {
		opacity: 1;
	}
</style>
